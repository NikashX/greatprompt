# Copy to .env and fill in. Never commit .env.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Abuse protection for the free, no-login app
RATE_LIMIT_PER_IP=5 per minute; 60 per day
GLOBAL_DAILY_LIMIT=3000 per day
MAX_REQUEST_CHARS=8000

# Source-code link shown in the header/footer (point it at your fork)
REPO_URL=https://github.com/NikashX/greatprompt

# Host port the container listens on (bound to 127.0.0.1; reverse proxy in front)
APP_PORT=8000
GUNICORN_THREADS=8

LOG_LEVEL=INFO
